{
  "description": "Example data set with nested (list) attributes: one record per component per sample, with a few flat metrics (MemTotal, free, load1min) plus two variable-length lists of sub-records attached to each sample. 'cpu' holds 2 entries per sample, each with a name and idle, sys, user and iowait values. 'netdev' holds 1 to 4 entries per sample, each with an interface name and rx/tx byte and packet counters. The lists mirror the per-core and per-interface records of the curated_metrics LDMS sampler plugin. Every value is a deterministic function of its coordinates. 'keys' lists the access paths the data set is meant to be queried by.",
  "name": "monitoring_nested",
  "attributes": [
    { "name": "timestamp",            "type": "timestamp" },
    { "name": "component_id",         "type": "uint64" },
    { "name": "job_id",               "type": "uint64" },
    { "name": "seq",                  "type": "uint64" },
    { "name": "MemTotal",             "type": "uint64", "range": [16777216, 41943040] },
    { "name": "free",                 "type": "double" },
    { "name": "load1min",             "type": "double" },
    {
      "name": "cpu",
      "type": "list",
      "min_list_length": 2,
      "max_list_length": 2,
      "entries": {
        "type": "record",
        "tuples": [
          { "name": "cpu_name", "type": "string", "length": 6 },
          { "name": "idle",     "type": "double" },
          { "name": "sys",      "type": "double" },
          { "name": "user",     "type": "double" },
          { "name": "iowait",   "type": "double" }
        ]
      }
    },
    {
      "name": "netdev",
      "type": "list",
      "min_list_length": 1,
      "max_list_length": 4,
      "length_stride": 1000000000,
      "entries": {
        "type": "record",
        "tuples": [
          { "name": "iface_name", "type": "string", "length": 5 },
          { "name": "rx_bytes",   "type": "uint64" },
          { "name": "rx_packets", "type": "uint64" },
          { "name": "tx_bytes",   "type": "uint64" },
          { "name": "tx_packets", "type": "uint64" }
        ]
      }
    }
  ],
  "keys": [
    { "name": "timestamp",     "attrs": ["timestamp"] },
    { "name": "comp_time",     "attrs": ["component_id", "timestamp"] },
    { "name": "job_comp_time", "attrs": ["job_id", "component_id", "timestamp"] }
  ]
}
